{
  "manifest_version": 3,
  "name": "Review Cockpit for GitHub",
  "short_name": "Review Cockpit",
  "version": "0.3.0",
  "description": "A faster, keyboard-first pull request review experience layered on top of GitHub.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Review Cockpit — your review queue",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.github.com/*", "https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/shared/core.js", "src/shared/ext.js", "src/content/panel.js"],
      "css": ["src/content/page.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/panel.css"],
      "matches": ["https://github.com/*"]
    }
  ]
}
